# ResearchCompass production environment template.
# Copy to .env.prod, replace every REQUIRED value, and never commit .env.prod.

YUXI_VERSION=0.11.0
YUXI_ENV=production
LITE_MODE=false

# REQUIRED: use independent, persistent random values. Tokens must be at least 32 characters.
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=
SANDBOX_PROVISIONER_TOKEN=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Model providers. Configure only the providers used by this deployment.
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=

# Same-origin production deployments may leave this empty.
YUXI_CORS_ORIGINS=
TRUSTED_PROXY_CIDRS=

# Optional infrastructure overrides.
POSTGRES_USER=postgres
POSTGRES_DB=yuxi
NEO4J_USERNAME=neo4j
MILVUS_DB_NAME=default
LANGGRAPH_CHECKPOINTER_BACKEND=postgres
SANDBOX_PROVIDER=provisioner
SANDBOX_PROVISIONER_BACKEND=docker
SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
SANDBOX_EXEC_TIMEOUT_SECONDS=180
SANDBOX_MAX_OUTPUT_BYTES=262144
